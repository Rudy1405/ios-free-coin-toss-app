<?xml version="1.0" encoding="utf-8"?>
<!-- Layout exclusivo del estado de carga: reemplaza el ProgressBar por el
     mismo flip_sequence de 36 frames (arte real) que usa la app principal,
     en chiquito, vía un ViewFlipper, uno de los pocos widgets "vivos" que
     Android permite dentro de un AppWidget: el host anima los hijos solo,
     sin que nuestro proceso seguir corriendo. Ver CLAUDE.md, "Widget de
     Android". Layout separado de coin_widget.xml a propósito: al pasar a
     idle/resultado se infla un RemoteViews totalmente distinto, así el
     ViewFlipper no queda escondido pero corriendo de fondo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
